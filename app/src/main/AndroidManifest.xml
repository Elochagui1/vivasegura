<?xml version="1.0" encoding="utf-8"?>
<manifest package="com.example.vivasegura"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo_app"
        android:label="@string/app_name"
        android:theme="@style/Theme.VivaSegura">

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false" />

        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false" />


        <activity
            android:name=".ui.premium.PremiumActivity"
            android:exported="false" />
        <activity
            android:name=".ui.panico.PanicoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.educativo.EducativoActivity"
            android:exported="false" />
        <activity
            android:name=".ui.denuncias.DenunciasActivity"
            android:exported="false" />

    </application>
</manifest>